# Models pulled into Ollama (docker compose reads these)
LLM_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Backend settings (used when running the API outside Docker: copy to backend/.env)
DATABASE_URL=postgresql+psycopg://insight:insight@localhost:5432/insightai
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
MAX_UPLOAD_MB=50
SQL_ROW_LIMIT=500
SQL_TIMEOUT_MS=15000
